# Copier ce fichier en .env (ignoré par git) et renseigner les valeurs
# depuis la console Upstash (base Redis, onglet REST API).
# Ne jamais commiter de vraies valeurs ici.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Depuis la console Resend (API Keys) : envoi du mail de signalement de bug.
# Offre gratuite sans domaine vérifié : BUG_REPORT_EMAIL doit être l'adresse du compte Resend lui-même,
# seule adresse autorisée à recevoir dans ce mode.
RESEND_API_KEY=
BUG_REPORT_EMAIL=
